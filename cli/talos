#!/bin/sh
# CLI oficial de Talos.
#
# POSIX shell: mismo runtime que los hooks, sin dependencias propias.
# Lo que necesita validar schemas delega en hooks/lib/resolve-validator.sh.
#
# Codigos de salida (talos-0.0.6.md 40.4):
#   0 exito  1 error de uso  2 precondition fallida  3 gate rechazado
#   4 escalacion requerida   5 error de adapter      6 migracion requerida

set -eu

# Dos raices distintas, como exige talos-0.0.6.md seccion 8:
#   SYSTEM  -> donde vive Talos      (.talos/ vendoreado, o el repo si se auto-hospeda)
#   PROJECT -> donde vive el trabajo (spec/, orchestration/, src/)
# Confundirlas hace que Talos busque el spec del producto dentro de si mismo.
CLI_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
TALOS_SYSTEM_ROOT=$(dirname "$CLI_DIR")

if [ -n "${TALOS_PROJECT_ROOT:-}" ]; then
    :
elif git rev-parse --show-toplevel >/dev/null 2>&1; then
    TALOS_PROJECT_ROOT=$(git rev-parse --show-toplevel)
else
    TALOS_PROJECT_ROOT=$(pwd)
fi

export TALOS_SYSTEM_ROOT TALOS_PROJECT_ROOT
export TALOS_CLI_DIR="$CLI_DIR"

TALOS_VERSION=$(cat "$TALOS_SYSTEM_ROOT/VERSION" 2>/dev/null || echo "desconocida")
export TALOS_VERSION

# El run_id sale del runtime, no de una variable que alguien recuerde exportar.
# Sin esto la evidencia queda sellada con "r-unknown" y la regla 22.6.7 -toda
# transicion reconstruible desde el event log- deja de cumplirse: no se puede
# reconstruir una corrida cuyos artefactos no dicen a que corrida pertenecen.
if [ -z "${TALOS_RUN_ID:-}" ] && [ -f "$TALOS_PROJECT_ROOT/orchestration/.meta.json" ]; then
    TALOS_RUN_ID=$(sed -n 's/.*"run_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                   "$TALOS_PROJECT_ROOT/orchestration/.meta.json" | head -1)
fi
export TALOS_RUN_ID

usage() {
    cat <<'USAGE'
talos - Guardian del ciclo de desarrollo con IA

USO
    talos <comando> [opciones]
    talos help <comando>          ayuda detallada de un comando

EMPEZAR
    talos init [--with-spec]      prepara orchestration/ en este proyecto
    talos doctor                  que falta y que nivel de enforcement hay

TRABAJAR
    talos spec check [ruta]       valida el spec del producto
    talos status                  estado del proyecto
    talos next                    que sigue, derivado del spec y el plan
    talos run [--max N]           avanza mientras los gates autoricen
    talos boot <FEATURE>          enciende al coordinador y le cede la decision
    talos budget [FEATURE]        presupuesto consumido contra el declarado
    talos rules [topic]           reglas activas y su mecanismo
    talos adapters                capacidades y que implementacion las satisface
    talos gate <maq> <de> <a>     evalua si una transicion esta autorizada
    talos evidence seal|check     sella y verifica evidencia
    talos plan check|init|show    planificacion de programa y PLAN_GATE
    talos feature start|list      ejecuta una feature del plan
    talos merge check|do <F>      MERGE_GATE y merge gobernado
    talos human approve|decide    registra una decision humana
    talos message list|answer     lo que los agentes dijeron, y tu respuesta

EVENTOS
    talos event append            registra un evento con secuencia
    talos event tail [n]          ultimos eventos

OTROS
    talos version                 version del sistema
    talos help                    esta ayuda

OPCIONES GLOBALES
    --format json                 salida estructurada
    -h, --help                    ayuda del comando

SALIDA
    0 exito              1 error de uso        2 precondition fallida
    3 gate rechazado     4 escalacion          5 error de adapter
    6 migracion requerida

Talos nunca instala herramientas de terceros: detecta y te dice como.
Documentacion: system/00-enforcement.md explica como se fuerza una regla.
USAGE
}

[ $# -eq 0 ] && { usage; exit 1; }

cmd="$1"
shift

# talos help <comando>  ->  <comando> --help
if [ "$cmd" = "help" ] && [ $# -gt 0 ]; then
    sub="$1"
    shift
    exec "$0" "$sub" "$@" --help
fi

case "$cmd" in
    -h|--help|help)
        usage
        ;;
    version|--version)
        echo "talos $TALOS_VERSION"
        ;;
    init|doctor|status|rules|adapters|gate|next|run|boot|budget|message)
        exec "$CLI_DIR/commands/$cmd.sh" "$@"
        ;;
    spec)
        sub="${1:-}"
        [ $# -gt 0 ] && shift
        case "$sub" in
            check) exec "$CLI_DIR/commands/spec-check.sh" "$@" ;;
            *) echo "talos: subcomando de spec desconocido: ${sub:-<vacio>}" >&2
               echo "talos: disponibles: check" >&2
               exit 1 ;;
        esac
        ;;
    evidence)
        exec "$CLI_DIR/commands/evidence.sh" "$@"
        ;;
    plan)
        exec "$CLI_DIR/commands/plan.sh" "$@"
        ;;
    feature)
        exec "$CLI_DIR/commands/feature.sh" "$@"
        ;;
    merge)
        exec "$CLI_DIR/commands/merge.sh" "$@"
        ;;
    human)
        exec "$CLI_DIR/commands/human.sh" "$@"
        ;;
    event)
        sub="${1:-}"
        [ $# -gt 0 ] && shift
        case "$sub" in
            append) exec "$CLI_DIR/commands/event-append.sh" "$@" ;;
            tail)   exec "$CLI_DIR/commands/event-tail.sh" "$@" ;;
            *) echo "talos: subcomando de event desconocido: ${sub:-<vacio>}" >&2
               echo "talos: disponibles: append, tail" >&2
               exit 1 ;;
        esac
        ;;
    *)
        echo "talos: comando desconocido: $cmd" >&2
        echo "" >&2
        usage >&2
        exit 1
        ;;
esac
