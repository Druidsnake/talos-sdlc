{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thalos-sdlc/schemas/adapter-manifest/0.0.6",
  "title": "AdapterManifest",
  "description": "Manifiesto de un adapter. Ver thalos-0.0.7.md secciones 37.4 y 38.",
  "type": "object",
  "required": ["id", "version", "api_version", "implements", "operations", "health_check", "supports_dry_run"],
  "properties": {
    "id": { "type": "string", "pattern": "^thalos\\.adapter\\.[a-z0-9_]+$" },
    "package": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "api_version": { "type": "string" },
    "core_compatibility": { "type": "string", "description": "Rango semver de versiones del core soportadas." },
    "implements": {
      "type": "string",
      "enum": ["FileSystemAdapter", "ModelProviderAdapter", "ExecutionAdapter", "CoordinationAdapter", "CIAdapter", "MessageTransport", "StateStore", "EventBus", "GateEvaluator", "RoutingStrategy", "RoleRegistry", "Validator", "Reporter", "MemoryAdapter"]
    },
    "supports_dry_run": { "type": "boolean" },
    "external_binary": {
      "type": ["object", "null"],
      "required": ["name", "version_range"],
      "properties": {
        "name": { "type": "string" },
        "version_range": { "type": "string", "description": "Ej: >=0.7.0" },
        "env_override": { "type": "string", "description": "Variable de entorno que tiene prioridad en la cascada de resolucion (seccion 37.4.5)." },
        "install_hint": { "type": "string", "description": "Comando exacto que Thalos muestra cuando el binario falta. Thalos nunca instala por su cuenta." },
        "machine_level": { "type": "boolean", "description": "true si gestiona estado de maquina o sesion y por lo tanto no debe vendorearse por proyecto." }
      },
      "additionalProperties": false
    },
    "health_check": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "default": 10 }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mutating"],
        "properties": {
          "name": { "type": "string" },
          "mutating": { "type": "boolean" },
          "idempotency": {
            "type": "string",
            "enum": ["required", "at_most_once", "not_applicable"],
            "description": "required para operaciones mutantes reintentables. at_most_once cuando el adapter no puede garantizar idempotencia: el core no la reintenta."
          },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "max_attempts": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "permissions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "operations": { "contains": { "properties": { "mutating": { "const": true } }, "required": ["mutating"] } } }
      },
      "then": {
        "properties": {
          "operations": {
            "items": {
              "if": { "properties": { "mutating": { "const": true } }, "required": ["mutating"] },
              "then": { "required": ["idempotency"] }
            }
          }
        }
      }
    }
  ]
}
