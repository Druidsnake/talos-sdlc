# GENERADO por tools/build-rules.py - NO EDITAR A MANO
# fuente: config/roles.yaml
# formato: <rol>\t<allow|deny>\t<glob>
# deny gana sobre allow. Sin allow que matchee, se deniega (fail-closed).

Developer	allow	src/**
Developer	allow	tests/**
Developer	allow	orchestration/features/*/tasks/**
Developer	deny	spec/**
Developer	deny	orchestration/program-plan.json
Developer	deny	orchestration/state.json
Developer	deny	orchestration/locks.json
Developer	deny	orchestration/events/**
Developer	deny	orchestration/evidence/**
Developer	deny	orchestration/reports/**
Developer	deny	orchestration/messages/**
Developer	deny	orchestration/features/*/feature-state.json
Developer	deny	.thalos/**
Developer	deny	thalos.config/**
Developer	deny	.github/workflows/**
FeatureLead	allow	orchestration/features/**
FeatureLead	allow	orchestration/messages/**
FeatureLead	deny	spec/**
FeatureLead	deny	src/**
FeatureLead	deny	tests/**
FeatureLead	deny	.thalos/**
FeatureLead	deny	orchestration/program-plan.json
Planner	allow	orchestration/program-plan.json
Planner	deny	spec/**
Planner	deny	src/**
Planner	deny	tests/**
Planner	deny	.thalos/**
Reviewer	allow	orchestration/reports/**
Reviewer	deny	spec/**
Reviewer	deny	src/**
Reviewer	deny	tests/**
Reviewer	deny	.thalos/**
SpecAssistant	allow	spec/**
SpecAssistant	deny	orchestration/**
SpecAssistant	deny	src/**
SpecAssistant	deny	tests/**
SpecAssistant	deny	.thalos/**
SpecAssistant	deny	thalos.config/**
